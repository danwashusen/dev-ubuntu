monitor = , preferred, auto, {{ hyprland_scale }}
{% if enable_parallels_hyprland_integration | bool %}
source = {{ workstation_home }}/.local/state/dev-ubuntu/parallels-monitor.conf
{% endif %}

$mainMod = {{ hyprland_main_modifier }}

{% if enable_parallels_hyprland_integration | bool %}
exec-once = systemctl --user import-environment DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec-once = systemctl --user daemon-reload
{% if parallels_dynamic_resolution_enabled | bool %}
exec-once = systemctl --user start parallels-prlcc-x11.service parallels-dynamic-resolution.service parallels-prlcp-wayland.service parallels-prldnd-wayland.service
{% else %}
exec-once = systemctl --user start parallels-prlcp-wayland.service parallels-prldnd-wayland.service
{% endif %}
{% endif %}
exec-once = waybar
exec-once = mako
exec-once = systemctl --user start hyprpolkitagent.service
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store

input {
    kb_layout = {{ keyboard_layout }}
    follow_mouse = 1

    touchpad {
        natural_scroll = true
    }
}

general {
    gaps_in = 4
    gaps_out = 8
    border_size = 2
    layout = dwindle
}

decoration {
    rounding = 6
}

animations {
    enabled = false
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
}

{% if enable_parallels_hyprland_integration | bool %}
# Parallels exposes its shared-clipboard helper as a Wayland toplevel whenever
# input is released. Keep that integration surface out of the tiled layout.
windowrule {
    name = parallels-shared-clipboard
    match:initial_title = ^Parallels Shared Clipboard$

    float = on
    size = 1 1
    move = -100 -100
}
{% endif %}

# Applications
bind = $mainMod, RETURN, exec, ghostty
bind = $mainMod, SPACE, exec, fuzzel
bind = $mainMod, B, exec, google-chrome-stable
bind = $mainMod SHIFT, B, exec, firefox
bind = $mainMod, C, exec, code
bind = $mainMod, E, exec, nautilus

# Windows
bind = $mainMod, Q, killactive
bind = $mainMod, F, fullscreen, 0
bind = $mainMod, V, togglefloating

# Session
bind = $mainMod, L, exec, swaylock -f -c 111111

# Clipboard history
bind = $mainMod, P, exec, cliphist list | fuzzel --dmenu | cliphist decode | wl-copy

# Screenshots
bind = $mainMod SHIFT, S, exec, grim -g "$(slurp)" - | wl-copy

# Focus
bind = $mainMod, LEFT, movefocus, l
bind = $mainMod, RIGHT, movefocus, r
bind = $mainMod, UP, movefocus, u
bind = $mainMod, DOWN, movefocus, d

# Move windows
bind = $mainMod SHIFT, LEFT, movewindow, l
bind = $mainMod SHIFT, RIGHT, movewindow, r
bind = $mainMod SHIFT, UP, movewindow, u
bind = $mainMod SHIFT, DOWN, movewindow, d

# Workspaces
{% for workspace in range(1, 10) %}
bind = $mainMod, {{ workspace }}, workspace, {{ workspace }}
bind = $mainMod SHIFT, {{ workspace }}, movetoworkspace, {{ workspace }}
{% endfor %}

# Mouse window manipulation
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Audio
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
